<?php
/**
 * BeautyBop FishPig post card
 *
 * @var \FishPig\WordPress\Block\Post\ListPost\Renderer\DefaultRenderer $block
 */

$post = $block->getPost();
?>

<?php if ($post): ?>
    <?php
    $postUrl = $post->getUrl();
    $postName = $post->getName();
    $categoryString = $post->getTermCollectionAsString('category');
    $imageUrl = null;

    if ($image = $post->getImage()) {
        $imageUrl = $image->getResizer()
            ? $image->getResizer()
                ->constrainOnly(true)
                ->keepFrame(false)
                ->keepAspectRatio(true)
                ->resize(900, 600)
            : $image->getImageUrl(['large', 'medium']);
    }
    ?>

    <article class="bb-journal-card">
        <?php if ($imageUrl): ?>
            <a
                class="bb-journal-card__image-link"
                href="<?= $block->escapeUrl($postUrl) ?>"
                aria-label="<?= $block->escapeHtmlAttr(__('Read %1', $postName)) ?>"
            >
                <img
                    class="bb-journal-card__image"
                    src="<?= $block->escapeUrl($imageUrl) ?>"
                    alt="<?= $block->escapeHtmlAttr($postName) ?>"
                    loading="lazy"
                >
            </a>
        <?php endif; ?>

        <div class="bb-journal-card__content">

        <span class="bb-journal-card__featured-label">
            <?= $block->escapeHtml(__('Featured Article')) ?>
        </span>

            <div class="bb-journal-card__meta">
                <?php if ($categoryString): ?>
                    <span class="bb-journal-card__category">
                        <?= $block->escapeHtml($categoryString, ['a']) ?>
                    </span>
                <?php endif; ?>

                <time class="bb-journal-card__date">
                    <?= $block->escapeHtml($post->getPostDate()) ?>
                </time>
            </div>

            <h2 class="bb-journal-card__title">
                <a href="<?= $block->escapeUrl($postUrl) ?>">
                    <?= $block->escapeHtml($postName) ?>
                </a>
            </h2>

            <?php if (!$post->isViewableForVisitor()): ?>
                <div class="bb-journal-card__protected">
                    <?= $block->getPasswordProtectHtml() ?>
                </div>
            <?php else: ?>
                <div class="bb-journal-card__excerpt">
                    <?= /* @noEscape */ $post->getExcerpt(32) ?>
                </div>
            <?php endif; ?>

            <a class="bb-journal-card__link" href="<?= $block->escapeUrl($postUrl) ?>">
                <?= $block->escapeHtml(__('Read article')) ?>
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </article>
<?php endif; ?>
<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">

    <policies>
        <policy id="script-src">
            <values>
                <value id="clarity-script" type="host">https://*.clarity.ms</value>
            </values>
        </policy>

        <policy id="connect-src">
            <values>
                <value id="clarity-connect" type="host">https://*.clarity.ms</value>
                <value id="clarity-bing-connect" type="host">https://c.bing.com</value>
            </values>
        </policy>
    </policies>

</csp_whitelist>
